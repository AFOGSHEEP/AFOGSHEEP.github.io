<% if (page.posts && page.posts.length > 0) { %>
<div class="bento-grid">
  <% page.posts.each(function(post) { %><%- partial('_partial/post-card', { post: post, isIndex: true }) %><% }) %>
</div>
<% } else { %>
<div class="text-center py-20 text-[var(--c-text3)]">
  <i data-lucide="file-text" class="w-12 h-12 mx-auto mb-4 opacity-30"></i>
  <p class="text-lg">还没有文章</p>
</div>
<% } %>
