<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=2">
<meta name="theme-color" content="#f9fbff">
<script>
/* pre-paint boot: apply saved style theme (鲸蓝/素瓷) + light/dark before first paint */
(function(){try{var s=localStorage.getItem('fa-style');if(s==='porcelain')document.documentElement.setAttribute('data-style','porcelain');if(localStorage.getItem('theme')!=='light')document.documentElement.classList.add('dark');}catch(e){}})();
</script>
<title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
<% if (page.description || config.description) { %><meta name="description" content="<%= page.description || config.description %>"><% } %>
<meta name="author" content="<%= config.author %>">
<link rel="canonical" href="<%= url_for(page.path) %>">
<meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
<meta property="og:title" content="<%= page.title || config.title %>">
<meta property="og:url" content="<%= url_for(page.path) %>">
<meta property="og:site_name" content="<%= config.title %>">
<% if (page.description || config.description) { %><meta property="og:description" content="<%= page.description || config.description %>"><% } %>
<meta property="og:locale" content="<%= config.language || 'zh_CN' %>">
<meta name="twitter:card" content="summary">
<% if (theme.seo && theme.seo.google_site_verification) { %><meta name="google-site-verification" content="<%= theme.seo.google_site_verification %>"><% } %>
<% if (theme.seo && theme.seo.baidu_site_verification) { %><meta name="baidu-site-verification" content="<%= theme.seo.baidu_site_verification %>"><% } %>
<% if (theme.seo && theme.seo.bing_site_verification) { %><meta name="msvalidate.01" content="<%= theme.seo.bing_site_verification %>"><% } %>
<% if (theme.images && theme.images.favicon) { %><link rel="icon" type="image/x-icon" href="<%= theme.images.favicon %>"><% } %>
<link rel="alternate" href="/atom.xml" title="<%= config.title %>" type="application/rss+xml">
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">

<!-- Tailwind — precompiled at build time (was: runtime CDN JIT compiler, the top jank source) -->
<link rel="stylesheet" href="/css/tailwind.css">

<!-- Fonts — self-hosted latin (zero cross-origin in default view) -->
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/fonts/inter.css">
<!-- CJK display/serif extras: loaded async (media=print swap) — never render-blocking -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@700&family=ZCOOL+QingKe+HuangYou&display=swap" media="print" onload="this.media='all'">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css" media="print" onload="this.media='all'">

<!-- Custom CSS (theme variables + components) -->
<link rel="stylesheet" href="/css/style.css">

<% if (theme.custom && theme.custom.css) { theme.custom.css.forEach(function(p) { %><link rel="stylesheet" href="<%= p %>"><% }) } %>
