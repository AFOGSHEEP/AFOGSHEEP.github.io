<nav class="fixed top-0 left-0 right-0 z-50 h-[4.5rem] border-b border-zinc-200 dark:border-zinc-800 bg-white/70 dark:bg-zinc-950/70 backdrop-blur-xl transition-colors duration-300">
  <div class="max-w-7xl mx-auto h-full flex items-center justify-between px-4 sm:px-6 lg:px-8">

    <div class="flex items-center gap-3 min-w-0">
      <% if (theme.images && theme.images.avatar && theme.images.avatar.url) { %>
      <div class="nav-avatar-wrap">
        <button id="nav-avatar-btn" class="nav-avatar-btn" aria-label="站长名片" aria-expanded="false" aria-haspopup="dialog">
          <img src="<%= theme.images.avatar.url %>" alt="avatar" class="nav-avatar-img" width="64" height="64">
        </button>
        <div id="avatar-pop-card" class="avatar-pop-card" role="dialog" aria-label="站长名片">
          <div class="avatar-pop-head">
            <div class="avatar-pop-meta">
              <div class="avatar-pop-name"><%= config.title %></div>
              <div class="avatar-pop-sub"><%= config.description %></div>
            </div>
          </div>
          <div class="avatar-pop-stats">
            <% var fa_earliest = 0; site.posts.each(function (p) { if (p.date) { var t = p.date.valueOf(); if (!fa_earliest || t < fa_earliest) fa_earliest = t; } }); var fa_days = fa_earliest ? Math.max(1, Math.floor((Date.now() - fa_earliest) / 86400000)) : 0; %>
            <span>文章 <b><%= site.posts.length %></b></span>
            <span class="avatar-pop-dot">·</span>
            <span>已运行 <b><%= fa_days %></b> 天</span>
            <span class="avatar-pop-dot">·</span>
            <span>标签 <b><%= site.tags.length %></b></span>
          </div>
          <% if (config.subtitle) { %><div class="avatar-pop-quote">「<%= config.subtitle %>」</div><% } %>
          <% var fa_map = {}; site.posts.each(function (p) { if (p.date) { var k = p.date.format('YYYY-MM-DD'); fa_map[k] = (fa_map[k] || 0) + 1; } }); %>
          <% var fa_max = 0; for (var mk in fa_map) { if (fa_map[mk] > fa_max) fa_max = fa_map[mk]; } %>
          <% var fa_today = new Date(); fa_today.setHours(12, 0, 0, 0); var fa_start = new Date(fa_today); fa_start.setDate(fa_start.getDate() - 20 * 7 + 1); fa_start.setDate(fa_start.getDate() - (fa_start.getDay() + 6) % 7); %>
          <div class="avatar-pop-heat">
            <div class="avatar-pop-recent-title">发文热力 · 近 20 周</div>
            <div class="avatar-pop-heat-grid">
              <% for (var dt = new Date(fa_start); dt <= fa_today; dt.setDate(dt.getDate() + 7)) { %>
              <div class="avatar-pop-heat-col">
                <% for (var d = 0; d < 7; d++) { var cd = new Date(dt); cd.setDate(dt.getDate() + d); if (cd > fa_today) { %><span class="avatar-pop-cell"></span><% } else { var ck = cd.getFullYear() + '-' + ('0' + (cd.getMonth() + 1)).slice(-2) + '-' + ('0' + cd.getDate()).slice(-2); var cc = fa_map[ck] || 0; var cl = cc === 0 ? 0 : Math.min(4, Math.ceil(cc / Math.max(fa_max, 1) * 4)); %>
                <span class="avatar-pop-cell h<%= cl %>" title="<%= ck %> · <%= cc %> 篇"></span><% } } %>
              </div>
              <% } %>
            </div>
          </div>
          <% if (theme.avatar_card && theme.avatar_card.pinned && theme.avatar_card.pinned.length) { %>
          <div class="avatar-pop-recent">
            <div class="avatar-pop-recent-title">精选文章</div>
            <% theme.avatar_card.pinned.forEach(function (p) { %>
            <a class="avatar-pop-post" href="<%= url_for(p.url) %>"><span class="avatar-pop-post-title"><%= p.title %></span><i data-lucide="star" class="avatar-pop-pin"></i></a>
            <% }) %>
          </div>
          <% } %>
          <div class="avatar-pop-visit">
            <i data-lucide="activity" class="avatar-pop-ico"></i>
            <span>本站访问 <b id="busuanzi_value_site_pv">…</b> 次 · 访客 <b id="busuanzi_value_site_uv">…</b> 人</span>
          </div>
          <div id="avatar-pop-secrets" class="avatar-pop-secrets" aria-label="已发现的秘密"></div>
          <% var fa_pool = site.posts.toArray().map(function (p) { return p.path; }); %>
          <div class="avatar-pop-actions">
            <a class="avatar-pop-link avatar-pop-link-primary" href="/"><i data-lucide="home" class="avatar-pop-ico"></i><span>回首页</span></a>
            <% if (fa_pool.length > 1) { %>
            <button class="avatar-pop-link" onclick="randomPost(this)" title="随机读一篇" data-pool='<%- JSON.stringify(fa_pool) %>'><i data-lucide="shuffle" class="avatar-pop-ico"></i><span>随便看看</span></button>
            <% } %>
            <% var fa_ico = { github: 'github', email: 'mail', twitter: 'twitter', zhihu: 'message-circle', weibo: 'at-sign', rss: 'rss', bilibili: 'tv', telegram: 'send' }; %>
            <% if (theme.social) { for (var sk in theme.social) { if (theme.social[sk]) { %>
            <a class="avatar-pop-link" href="<%= theme.social[sk] %>"<%= sk === 'email' ? '' : ' target="_blank" rel="noopener"' %> title="<%= sk %>"><i data-lucide="<%= fa_ico[sk] || 'link' %>" class="avatar-pop-ico"></i><span><%= sk %></span></a>
            <% } } } %>
            <button class="avatar-pop-link" onclick="copyEmail('q2420844892@163.com')" title="复制邮箱"><i data-lucide="copy" class="avatar-pop-ico"></i><span>复制邮箱</span></button>
          </div>
        </div>
      </div>
      <% } %>
      <a href="/" id="nav-site-title" class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 hover:text-accent-500 dark:hover:text-accent-400 transition-colors truncate"><%= config.title %></a>
      <span class="nav-date hidden xl:inline" aria-hidden="true"><span id="nav-date"></span></span>
    </div>

    <div class="hidden md:flex items-center gap-0.5">
      <% if (theme.navbar.menu) { for (var key in theme.navbar.menu) { var path = theme.navbar.menu[key]; var isActive = (page.path === path) || (path !== '/' && page.path && page.path.indexOf(path.replace(/\//g,'')) === 0); %>
      <a href="<%= path %>" class="nav-link <%= isActive ? 'nav-link-active' : '' %>"><%= key %></a>
      <% }} %>
      <div class="flex items-center gap-1 ml-2 pl-2 border-l border-zinc-200 dark:border-zinc-800">
        <% if (theme.search && theme.search.enable) { %>
        <button onclick="toggleSearch()" class="p-2 rounded-lg text-zinc-400 dark:text-zinc-500 hover:text-zinc-600 dark:hover:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all flex items-center" aria-label="搜索">
          <i data-lucide="search" class="w-4 h-4"></i><kbd class="nav-kbd hidden lg:inline-flex">/</kbd>
        </button>
        <% } %>
        <% if (theme.color_scheme && theme.color_scheme.toggle) { %>
        <div class="hidden lg:flex items-center gap-0.5 p-0.5 rounded-full border border-zinc-200 dark:border-zinc-800 ml-1" role="group" aria-label="界面风格">
          <button class="style-chip" data-style-btn="whale" aria-label="鲸蓝瓷面" title="鲸蓝瓷面"><span class="style-dot" style="background:#4d6bfe"></span></button>
          <button class="style-chip" data-style-btn="porcelain" aria-label="素瓷" title="素瓷"><span class="style-dot" style="background:#10a37f"></span></button>
        </div>
        <button data-mode-toggle class="p-2 rounded-lg text-zinc-400 dark:text-zinc-500 hover:text-zinc-600 dark:hover:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all" aria-label="切换深色/浅色"><i data-mode-icon data-lucide="sun" class="w-4 h-4"></i></button>
        <% } %>
        <button id="font-switcher" class="p-2 rounded-lg text-zinc-400 dark:text-zinc-500 hover:text-accent-500 dark:hover:text-accent-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all" aria-label="切换字体" title="切换字体"><i data-lucide="type" class="w-4 h-4"></i></button>
      </div>
    </div>

    <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-zinc-500" aria-label="菜单"><i data-lucide="menu" class="w-5 h-5"></i></button>
  </div>

  <div id="nav-progress" class="nav-progress" aria-hidden="true"></div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-zinc-200 dark:border-zinc-800 px-4 pb-4 pt-2">
    <% if (theme.navbar.menu) { for (var key in theme.navbar.menu) { var path = theme.navbar.menu[key]; var isActive = (page.path === path) || (path !== '/' && page.path && page.path.indexOf(path.replace(/\//g,'')) === 0); %>
    <a href="<%= path %>" class="block px-4 py-3 rounded-lg text-sm font-medium transition-all <%= isActive ? 'text-accent-500 dark:text-accent-400 bg-accent-50 dark:bg-accent-500/10' : 'text-zinc-500 dark:text-zinc-400' %>"><%= key %></a>
    <% }} %>
    <div class="flex gap-2 px-4 pt-2 items-center">
      <% if (theme.search && theme.search.enable) { %><button onclick="toggleSearch()" class="p-2 rounded-lg text-sm text-zinc-500 dark:text-zinc-400">搜索</button><% } %>
      <% if (theme.color_scheme && theme.color_scheme.toggle) { %>
      <button class="style-chip-text" data-style-btn="whale" aria-pressed="false">鲸蓝</button>
      <button class="style-chip-text" data-style-btn="porcelain" aria-pressed="false">素瓷</button>
      <button data-mode-toggle class="p-2 rounded-lg text-sm text-zinc-500 dark:text-zinc-400"><i data-mode-icon data-lucide="sun" class="w-4 h-4 inline"></i> 明暗</button>
      <% } %>
    </div>
  </div>
</nav>
