<% var cover = post_cover(post); var isIndex = typeof isIndex !== 'undefined' ? isIndex : false; %>
<a href="<%= url_for(post.path) %>" class="post-card glass-card flex flex-col gap-3 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 <%= post.top ? 'featured' : '' %>" data-aos="fade-up" data-aos-duration="500">

  <% if (cover) { %><div class="rounded-lg bg-cover bg-center flex-shrink-0" style="background-image:url('<%= cover %>'); height:120px;"></div><% } %>

  <% if (post.categories && post.categories.length > 0) { %>
  <div class="inline-flex items-center gap-1 text-xs font-medium uppercase tracking-wider text-indigo-500 dark:text-indigo-400">
    <i data-lucide="folder" class="w-3 h-3"></i>
    <%= post.categories.data ? post.categories.data[0].name : (typeof post.categories[0] === 'object' ? post.categories[0].name : post.categories[0]) %>
  </div>
  <% } %>

  <h3 class="card-title"><% if (post.top) { %><i data-lucide="pin" class="w-3 h-3 inline text-amber-500"></i> <% } %><%= post.title %></h3>

  <% if (isIndex && theme.homepage.excerpt_method !== 'none') { %>
  <p class="card-excerpt text-zinc-500 dark:text-zinc-400 flex-1"><%= post.excerpt ? truncate_excerpt(post.excerpt, theme.homepage.excerpt_length || 200) : (post.description || '') %></p>
  <% } %>

  <div class="card-meta flex items-center gap-4 text-xs text-zinc-400 dark:text-zinc-500 mt-auto">
    <span class="inline-flex items-center gap-1"><i data-lucide="calendar" class="w-3 h-3"></i> <%= format_date(post.date, 'date') %></span>
    <% if (theme.misc && theme.misc.word_count && post.content) { %><span class="inline-flex items-center gap-1"><i data-lucide="clock" class="w-3 h-3"></i> <%= reading_time(post.content) %></span><% } %>
  </div>
</a>
