<% if (theme.post && theme.post.reading_progress) { %><div class="reading-progress"></div><% } %>

<article class="max-w-3xl mx-auto pt-8">

  <header class="text-center mb-10">
    <h1 class="text-3xl sm:text-4xl font-bold mb-4" data-aos="fade-down"><%= page.title %></h1>
    <div class="flex justify-center items-center flex-wrap gap-4 text-sm text-zinc-400 dark:text-zinc-500" data-aos="fade-up" data-aos-delay="100">
      <span class="inline-flex items-center gap-1"><i data-lucide="calendar" class="w-3.5 h-3.5"></i> <%= format_date(page.date, 'date') %></span>
      <% if (page.categories && page.categories.length > 0) { %><span class="inline-flex items-center gap-1"><i data-lucide="folder" class="w-3.5 h-3.5"></i><% var cats = page.categories.toArray ? page.categories.toArray() : (page.categories.data || []); cats.forEach(function(c, idx) { %><a href="<%= url_for(c.path) %>" class="text-indigo-500 hover:text-indigo-600"><%= c.name %></a><% if (idx < cats.length-1) { %>, <% } %><% }) %></span><% } %>
      <% if (theme.misc && theme.misc.word_count && page.content) { %><span class="inline-flex items-center gap-1"><i data-lucide="clock" class="w-3.5 h-3.5"></i> <%= reading_time(page.content) %></span><span class="inline-flex items-center gap-1"><i data-lucide="type" class="w-3.5 h-3.5"></i> <%= word_count(page.content) %> 字</span><% } %>
    </div>
    <% var cover = post_cover(page); if (cover) { %><img src="<%= cover %>" alt="<%= page.title %>" class="w-full max-h-96 object-cover rounded-xl mt-6" data-aos="fade-up" data-aos-delay="200"><% } %>
  </header>

  <%
    var tocContent = toc(page.content, { list_number: false, max_depth: 2 });
    var hasToc = tocContent && tocContent.trim().length > 0;
  %>

  <% if (hasToc) { %>
  <div class="toc-horizontal glass mb-8 px-5 py-3 rounded-xl bg-white/60 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 text-sm" data-aos="fade-up" data-aos-delay="250">
    <span class="font-semibold text-zinc-500 dark:text-zinc-400 mr-3 text-xs uppercase tracking-wider"><%= __('toc') %></span>
    <%- tocContent %>
  </div>
  <% } %>

  <div class="article-body" data-aos="fade-up" data-aos-delay="300">
      <%- page.content %>
      <% if (page.tags && page.tags.length > 0) { %>
      <div class="flex flex-wrap items-center gap-2 mt-8 pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <i data-lucide="tag" class="w-4 h-4 text-zinc-400 dark:text-zinc-500"></i>
        <% page.tags.each(function(tag) { %><a href="<%= url_for(tag.path) %>" class="inline-block px-3 py-1 text-xs font-medium rounded-full bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-100 dark:hover:bg-indigo-500/25 transition-colors">#<%= tag.name %></a><% }) %>
      </div>
      <% } %>
      <% if (theme.post && theme.post.copyright !== false) { %>
      <div class="mt-8 p-4 rounded-lg bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-sm text-zinc-500 dark:text-zinc-400">
        <p class="font-semibold text-zinc-700 dark:text-zinc-300 mb-1"><%= __('copyright') %></p>
        <p><%= __('copyright_text') %></p>
        <p class="mt-1">本文链接：<a href="<%= config.url %><%= page.path %>" class="text-indigo-500"><%= config.url %><%= page.path %></a></p>
      </div>
      <% } %>
  </div>

  <% if (theme.post && theme.post.post_nav !== false) { %>
  <nav class="grid grid-cols-2 gap-4 mt-12 pt-8 border-t border-zinc-200 dark:border-zinc-800" data-aos="fade-up">
    <% if (page.prev) { %><a href="<%= url_for(page.prev.path) %>" class="flex flex-col gap-1 p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-indigo-300 dark:hover:border-indigo-600 transition-all"><span class="text-xs uppercase tracking-wider text-zinc-400 dark:text-zinc-500"><i data-lucide="arrow-left" class="w-3 h-3 inline"></i> <%= __('prev') %></span><span class="text-sm font-semibold"><%= page.prev.title %></span></a><% } else { %><div></div><% } %>
    <% if (page.next) { %><a href="<%= url_for(page.next.path) %>" class="flex flex-col gap-1 p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-indigo-300 dark:hover:border-indigo-600 transition-all text-right"><span class="text-xs uppercase tracking-wider text-zinc-400 dark:text-zinc-500"><%= __('next') %> <i data-lucide="arrow-right" class="w-3 h-3 inline"></i></span><span class="text-sm font-semibold"><%= page.next.title %></span></a><% } %>
  </nav>
  <% } %>

  <% if (theme.comment && theme.comment.enable && theme.comment.giscus) { %>
  <div class="mt-12 pt-8 border-t border-zinc-200 dark:border-zinc-800" data-aos="fade-up">
    <% var g = theme.comment.giscus; %><script src="https://giscus.app/client.js" data-repo="<%= g.repo %>" data-repo-id="<%= g.repo_id %>" data-category="<%= g.category %>" data-category-id="<%= g.category_id %>" data-mapping="<%= g.mapping %>" data-strict="<%= g.strict %>" data-reactions-enabled="<%= g.reactions %>" data-emit-metadata="0" data-input-position="<%= g.input_position %>" data-theme="preferred_color_scheme" data-lang="<%= g.lang %>" crossorigin="anonymous" async data-no-instant></script>
  </div>
  <% } %>

</article>
