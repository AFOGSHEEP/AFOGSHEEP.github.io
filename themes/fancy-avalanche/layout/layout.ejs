<!DOCTYPE html>
<html lang="zh-CN" class="overflow-x-hidden">
<head><%- partial('_partial/head', { page, config, theme }) %></head>
<body class="font-sans antialiased transition-colors duration-500 overflow-x-hidden">

  <%- partial('_partial/background', { page, config, theme }) %>

  <%- partial('_partial/navbar', { page, config, theme }) %>

  <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-[4.5rem] pb-16 min-h-screen">
    <%- body %>
  </main>

  <%- partial('_partial/footer', { page, config, theme }) %>
  <%- partial('_partial/search', { page, config, theme, site }) %>

  <% if (theme.effects && theme.effects.back_to_top) { %>
  <button id="back-to-top" class="fixed bottom-8 right-8 z-50 w-12 h-12 rounded-full flex items-center justify-center glass opacity-0 invisible" aria-label="回到顶部">
    <svg class="progress-ring" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true">
      <circle class="ring-bg" cx="24" cy="24" r="20"></circle>
      <circle class="ring-fg" cx="24" cy="24" r="20"></circle>
    </svg>
    <i data-lucide="arrow-up" class="btt-icon w-5 h-5"></i>
  </button>
  <% } %>

  <script src="<%= theme.cdn.lucide %>" data-no-instant></script>
  <script data-no-instant>lucide.createIcons();</script>

  <% if (theme.effects && theme.effects.scroll_reveal) { %>
  <link rel="stylesheet" href="<%= theme.cdn.aos_css %>">
  <script src="<%= theme.cdn.aos_js %>" data-no-instant></script>
  <script data-no-instant>AOS.init({ duration: 600, once: true, offset: 80 });</script>
  <% } %>

  <% if (theme.code_highlight && (is_post() || is_page())) { %>
  <link rel="stylesheet" href="<%= theme.cdn.highlight_css %>">
  <script src="<%= theme.cdn.highlight_js %>" data-no-instant></script>
  <script data-no-instant>hljs.configure({ tabReplace: '  ' }); hljs.highlightAll();</script>
  <% } %>

  <% if (theme.effects && theme.effects.pjax) { %>
  <script src="<%= theme.cdn.instantclick %>" data-no-instant></script>
  <script data-no-instant>InstantClick.init('mousedown');InstantClick.on('change',function(){lucide.createIcons();if(typeof AOS!=='undefined')AOS.refresh();if(typeof hljs!=='undefined')hljs.highlightAll();if(window.__faWidgets)window.__faWidgets();if(window.__faTheme)window.__faTheme();if(window.__faAvatar)window.__faAvatar()});</script>
  <% } %>

  <script src="/js/main.js" data-no-instant></script>

  <!-- Font Switcher -->
  <script data-no-instant>
    (function(){
      var FONTS = ['plus-jakarta', 'inter', 'source-serif'];
      var saved = localStorage.getItem('font-preference') || 'plus-jakarta';
      var cur = FONTS.indexOf(saved);
      if (cur < 0) cur = 0;
      applyFont(FONTS[cur]);

      function applyFont(name) {
        var h = document.documentElement;
        FONTS.forEach(function(f) { h.removeAttribute('data-font'); });
        if (name !== 'plus-jakarta') h.setAttribute('data-font', name);
      }

      var btn = document.getElementById('font-switcher');
      if (btn) btn.addEventListener('click', function() {
        cur = (cur + 1) % FONTS.length;
        var name = FONTS[cur];
        applyFont(name);
        localStorage.setItem('font-preference', name);
      });
    })();
  </script>

  <% var bgType = (theme.background && theme.background.type) || 'gradient'; if (bgType === 'canvas' || bgType === 'three') { %>
  <script src="/js/background.js" data-no-instant></script>
  <% } %>
</body>
</html>
