<% if (page.category) { %>
  <%# Individual category page — list posts %>
  <div data-aos="fade-up" class="max-w-3xl mx-auto">
    <h1 class="text-center text-3xl font-bold mb-2"><%= page.category %></h1>
    <p class="text-center text-zinc-400 dark:text-zinc-500 mb-12"><%= page.posts.length %> 篇文章</p>
    <div class="space-y-4"><% page.posts.each(function(post) { %><%- partial('_partial/post-card', { post: post, isIndex: false }) %><% }) %></div>
    <% if (page.total > 1) { %><div class="pagination mt-8"><%- paginator({ mid_size: 2, end_size: 1 }) %></div><% } %>
  </div>
<% } else { %>
  <%# Category index page — show all categories as cards %>
  <div data-aos="fade-up" class="max-w-4xl mx-auto">
    <h1 class="text-center text-3xl font-bold mb-12"><%= __('categories') %></h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% site.categories.each(function(cat) { %>
      <a href="<%= url_for(cat.path) %>" class="flex items-center gap-4 p-6 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-accent-300 dark:hover:border-accent-600 hover:shadow-lg transition-all">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-accent-100 dark:bg-accent-500/20 flex items-center justify-center text-2xl"><i data-lucide="folder" class="w-6 h-6 text-accent-500 dark:text-accent-400"></i></div>
        <div><h3 class="font-semibold text-lg"><%= cat.name %></h3><p class="text-sm text-zinc-400 dark:text-zinc-500"><%= cat.posts.length %> 篇文章</p></div>
      </a>
      <% }) %>
    </div>
  </div>
<% } %>
